<file path="css/base.css">
/* =========================================================
   base.css – foundation (clean & stable)
   ========================================================= */

:root {
  --violet-900: #3b2b5f;
  --violet-700: #5b3fa3;
  --violet-500: #7b5cd6;
  --violet-300: #cbbcff;

  --pink-200: #f6c1e8;
  --mint-200: #c7f0ea;

  --bg-main: #f7f6fb;
  --bg-card: #ffffff;

  --border-soft: #e6e2f3;
  --focus-ring: #ffbf47;
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: "Inter", system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
  background: linear-gradient(180deg, #f5f2ff 0%, #f7f6fb 100%);
  color: #1e1e2f;
  line-height: 1.5;
}

h1, h2, h3 {
  margin: 0;
  color: var(--violet-900);
}

label {
  font-weight: 600;
  font-size: 0.85rem;
}

/* FORM NORMALIZATION */

input,
select,
textarea,
button {
  font-family: inherit;
  font-size: 0.9rem;
  line-height: 1.3;
}

input,
select {
  height: 36px;
}

textarea {
  min-height: 64px;
}

/* ACCESSIBILITY */

.visually-hidden {
  position: absolute !important;
  height: 1px;
  width: 1px;
  overflow: hidden;
  clip: rect(1px, 1px, 1px, 1px);
  white-space: nowrap;
}
</file>

<file path="css/components.css">
/* =========================================================
   components.css – STATUS, TEXTAREA, BADGES (REFINED)
   ========================================================= */

/* ======================
   TEXT INPUTS
   ====================== */

input[type="text"],
textarea {
  width: 100%;
  font-family: inherit;
  font-size: 0.9rem;
  line-height: 1.4;
  border: 1px solid var(--border-soft);
  border-radius: 12px;
  padding: 10px 12px;
  background: #ffffff;
}

/* główne pola pracy audytora */
.col-issue textarea,
.col-expected textarea {
  min-height: 140px;
  background: #faf9ff;
}

/* pola kodu */
.col-code textarea {
  min-height: 160px;
  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  font-size: 0.8rem;
  background: #f6f4ff;
}

/* textarea wypełnia wysokość komórki */
.audit-table td {
  vertical-align: top;
}

.audit-table td textarea {
  height: 100%;
}

/* focus */
input:focus,
textarea:focus {
  outline: 2px solid var(--violet-500);
  outline-offset: 1px;
}

/* ======================
   STATUS – JEDEN SWITCHER (PIONOWO)
   ====================== */

.status-radios.vertical {
  display: flex;
  flex-direction: column;
  gap: 6px;
  width: 100%;
}

/* KAŻDA opcja = TEN SAM SLOT */
.status-radios label {
  position: relative;
  display: flex;
  align-items: center;
  height: 36px;
  padding: 0 10px;
  border-radius: 10px;
  font-size: 0.8rem;
  cursor: pointer;
  background: #f3efff;
  color: var(--violet-900);
}

/* ukrywamy natywne radio */
.status-radios input {
  position: absolute;
  opacity: 0;
  pointer-events: none;
}

/* zaznaczenie – ZAWSZE CAŁY SLOT */
.status-radios label:has(input:checked) {
  background: #ffffff;
  box-shadow: 0 2px 6px rgba(123, 92, 214, 0.25);
}

/* treść */
.status-radios span {
  display: flex;
  align-items: center;
  gap: 6px;
}

/* ======================
   FAILURE DETAIL – DRUGI POZIOM (STABILNY)
   ====================== */

/* zawsze rezerwujemy miejsce – brak skakania */
.failure-detail {
  margin-top: 6px;
  padding-left: 8px;
  border-left: 2px solid #e6e2f3;
  min-height: 88px;
}

.failure-detail.hidden {
  visibility: hidden;
}

/* radio ❌ jako logiczny pod-blok */
.failure-detail-radios {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.failure-detail-radios label {
  display: flex;
  align-items: center;
  height: 28px;
  padding: 0 8px;
  font-size: 0.75rem;
  border-radius: 8px;
  cursor: pointer;
  background: #f7f6fb;
  color: #3b2b5f;
}

.failure-detail-radios input {
  margin-right: 6px;
}

/* ======================
   BADGES
   ====================== */

.badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 4px 8px;
  border-radius: 999px;
  font-size: 0.75rem;
  font-weight: 600;
  white-space: nowrap;
  text-transform: capitalize; /* ✅ sentence case */
}

/* obszar */
.area-dev { background: #e3f2fd; color: #0d47a1; }
.area-content { background: #e8f5e9; color: #1b5e20; }
.area-design { background: #f3e5f5; color: #4a148c; }
.area-mixed { background: #ede7f6; color: #4527a0; }

/* priorytet */
.priority-critical { background: #fdecea; color: #b00020; }
.priority-high { background: #fff4e5; color: #e65100; }
.priority-medium { background: #fffde7; color: #9e7700; }

/* ======================
   BUTTONS
   ====================== */

button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 36px;
  padding: 0 16px;
  border-radius: 999px;
  border: none;
  background: linear-gradient(
    135deg,
    #7b5cd6 0%,
    #b084f5 100%
  );
  color: #ffffff;
  font-size: 0.8rem;
  cursor: pointer;
}

button:hover {
  filter: brightness(1.05);
}

button:focus {
  outline: 3px solid var(--focus-ring);
  outline-offset: 2px;
}

/* główna akcja */
.audit-meta #save-version-btn {
  background: linear-gradient(
    135deg,
    #5b3fa3 0%,
    #7b5cd6 100%
  );
  font-weight: 600;
}

/* eksporty */
.global-actions button {
  background: #ffffff;
  color: var(--violet-900);
  box-shadow: 0 6px 18px rgba(91, 63, 163, 0.25);
}

.global-actions button:hover {
  background: #f7f4ff;
}

/* zapis wiersza */
.save-row {
  height: 34px;
  padding: 0 14px;
  font-size: 0.75rem;
}

.row-date {
  margin-top: 4px;
  font-size: 0.7rem;
  color: #666666;
  text-align: center;
}

/* =========================================================
   CRITERION DESCRIPTION (ADD-ON)
   ========================================================= */

.col-name .criterion-desc {
  margin-top: 4px;
  font-size: 0.75rem;
  line-height: 1.4;
  color: #666666;
}

/* =========================================================
   GLOBAL FILTERS (ADD-ON)
   ========================================================= */

.audit-filters {
  margin: 2rem 0;
  padding: 1.5rem;
  background: #ffffff;
  border-radius: 18px;
  box-shadow: 0 8px 24px rgba(91, 63, 163, 0.1);
}

.audit-filters h2 {
  margin-bottom: 1rem;
  color: var(--violet-900);
}

/* grid filtrów */

.filters-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 1.25rem;
}

/* grupa filtrów */

.filter-group {
  border: 1px solid var(--border-soft);
  border-radius: 14px;
  padding: 0.75rem 0.75rem 0.5rem;
  background: #faf9ff;
}

.filter-group legend {
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--violet-900);
  padding: 0 6px;
}

/* checkboxy TYLKO w filtrach */

.filter-group label {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.8rem;
  cursor: pointer;
  margin: 0.35rem 0;
  color: #1e1e2f;
}

.filter-group input[type="checkbox"] {
  width: 16px;
  height: 16px;
  cursor: pointer;
}

.filter-group input[type="checkbox"]:focus-visible {
  outline: 2px solid var(--focus-ring);
  outline-offset: 2px;
}


/* =========================================================
   VIEW‑ONLY
   ========================================================= */

.readonly {
  padding: 6px 8px;
  background: #f7f6fb;
  border-radius: 8px;
  font-size: 0.8rem;
  line-height: 1.4;
  color: #333333;
  white-space: pre-wrap;
}

.status-readonly {
  font-weight: 600;
  font-size: 0.8rem;
}

/* =========================================================
   STATUS (RADIOS)
   ========================================================= */

.status-radios.vertical {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.status-radios label {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 0.75rem;
  cursor: pointer;
}

/* =========================================================
   FAILURE DETAIL
   ========================================================= */

.failure-detail {
  margin-top: 6px;
  padding-left: 8px;
  border-left: 2px solid #e6e2f3;
}

.failure-detail.hidden {
  display: none;
}

.failure-detail-radios {
  display: flex;
  flex-direction: column;
  gap: 4px;
  font-size: 0.7rem;
}

/* =========================================================
   BADGES (AREA / PRIORITY)
   ========================================================= */

.badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 4px 8px;
  border-radius: 999px;
  font-size: 0.7rem;
  font-weight: 600;
  cursor: pointer;
  border: none;
  background: #ede8ff;
  color: #3b2b5f;
}

.badge:hover {
  background: #e0d9ff;
}

/* area */

.area-development { background: #e3f2fd; color: #0d47a1; }
.area-content     { background: #e8f5e9; color: #1b5e20; }
.area-design      { background: #f3e5f5; color: #4a148c; }
.area-mixed       { background: #ede7f6; color: #4527a0; }

/* priority */

.priority-critical { background: #fdecea; color: #b00020; }
.priority-high     { background: #fff4e5; color: #e65100; }
.priority-medium   { background: #fffde7; color: #9e7700; }

/* =========================================================
   BADGE POPUP
   ========================================================= */

.badge-popup {
  position: absolute;
  z-index: 1000;
  background: #ffffff;
  border-radius: 14px;
  padding: 12px;
  box-shadow: 0 8px 24px rgba(91,63,163,0.25);
  min-width: 180px;
}

.badge-popup label {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 0.75rem;
  margin-bottom: 6px;
  cursor: pointer;
}

.badge-popup button {
  margin-top: 8px;
  width: 100%;
  height: 32px;
  border-radius: 999px;
  border: none;
  background: linear-gradient(135deg, #7b5cd6, #b084f5);
  color: #ffffff;
  font-size: 0.75rem;
  cursor: pointer;
}

/* =========================================================
   FILTERS – VISUAL STATES
   ========================================================= */

.filter-include {
  background: #e8f5e9;
  border-radius: 6px;
}

.filter-exclude {
  background: #fdecea;
  border-radius: 6px;
  text-decoration: line-through;
}

/* =========================================================
   SAVE FEEDBACK
   ========================================================= */

tr.saving {
  opacity: 0.5;
}

tr.saved {
  animation: savedFlash 0.8s ease;
}

@keyframes savedFlash {
  0%   { background: #e8f5e9; }
  100% { background: transparent; }
}
</file>

<file path="css/layout.css">
/* =========================================================
   layout.css – structure, table layout, spacing
   (WERSJA BEZ colgroup, STABILNA DLA WEB / APP)
   ========================================================= */

/* ======================
   HEADER
   ====================== */

.app-header {
  background: linear-gradient(
    135deg,
    #7b5cd6 0%,
    #b084f5 50%,
    #f6c1e8 100%
  );
  padding: 2.5rem 2rem 3rem;
  color: #ffffff;
}

.app-header h1 {
  color: #ffffff;
  margin-bottom: 1.25rem;
}

/* ======================
   META CARD
   ====================== */

.audit-meta {
  background: #ffffff;
  padding: 2rem;
  border-radius: 22px;
  box-shadow: 0 12px 32px rgba(123, 92, 214, 0.25);
  color: #1e1e2f;
}

.meta-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 1.25rem;
}

.meta-field {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}

/* ======================
   GLOBAL ACTIONS
   ====================== */

.global-actions {
  margin-top: 1.5rem;
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
}

/* ======================
   MAIN
   ====================== */

main {
  padding: 2rem;
}

/* ======================
   WCAG GROUP CARD
   ====================== */

.wcag-group {
  margin-bottom: 3rem;
  background: linear-gradient(
    180deg,
    #ffffff 0%,
    #f9f7ff 100%
  );
  border-radius: 22px;
  padding: 1.5rem;
  box-shadow: 0 8px 24px rgba(91, 63, 163, 0.08);
  overflow-x: auto;
}

.wcag-group h2 {
  margin-bottom: 1rem;
}

/* ======================
   AUDIT TABLE – BASE
   ====================== */

.audit-table {
  width: 100%;
  border-collapse: collapse;
  background: #ffffff;
  border-radius: 14px;
}

/* ======================
   TABLE HEADER
   ====================== */

.audit-table thead th {
  background: linear-gradient(
    180deg,
    #f0ebff 0%,
    #e9e3ff 100%
  );
  color: var(--violet-900);
  font-weight: 600;
  font-size: 0.85rem;
  text-align: left;
  padding: 0.6rem;
  border-bottom: 1px solid var(--border-soft);
  border-right: 1px solid var(--border-soft);
  vertical-align: top;
}

.audit-table thead th:last-child {
  border-right: none;
}

/* ======================
   TABLE BODY
   ====================== */

.audit-table tbody td {
  padding: 0.6rem;
  font-size: 0.85rem;
  border-bottom: 1px solid var(--border-soft);
  border-right: 1px solid var(--border-soft);
  vertical-align: top;
}

.audit-table tbody td:last-child {
  border-right: none;
}

/* ======================
   COLUMN WIDTHS & ALIGNMENT
   ====================== */

.audit-table .col-nr {
  width: 60px;
  text-align: center;
  font-weight: 600;
  color: #555555;
}

.audit-table .col-level {
  width: 80px;
  text-align: center;
  font-weight: 600;
}

.audit-table .col-status {
  width: 180px;
}

.audit-table .col-issue,
.audit-table .col-expected {
  min-width: 260px;
  line-height: 1.5;
}

.audit-table .col-code {
  min-width: 260px;
  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  font-size: 0.8rem;
}

.audit-table .col-area {
  width: 90px;
  text-align: center;
}

.audit-table .col-priority {
  width: 120px;
  text-align: center;
}

.audit-table .col-action {
  width: 140px;
  text-align: center;
  white-space: nowrap;
}

/* ======================
   WEB / APP
   ====================== */

.audit-table.is-app .web-only {
  display: none !important;
}

.audit-table.is-web .web-only {
  display: table-cell;
}

/* ======================
   SUMMARY
   ====================== */

.audit-summary {
  background: linear-gradient(
    135deg,
    #ede8ff 0%,
    #f7f6fb 100%
  );
  padding: 2rem;
  border-top: 2px solid var(--violet-300);
}

.audit-summary h2 {
  margin-bottom: 1rem;
}

.summary-section {
  margin-bottom: 1.5rem;
}
</file>

<file path="css/print.css">
/* =========================================================
   print.css – clean report, no unicorns 🖨️
   ========================================================= */

@media print {

  body {
    background: #ffffff;
  }

  .global-actions,
  button,
  input,
  textarea,
  select {
    display: none !important;
  }

  .wcag-group {
    box-shadow: none;
    background: #ffffff;
  }

  .audit-table th {
    background: #eeeeee !important;
    color: #000000 !important;
  }

  tr.pass,
  tr.fail,
  tr.not-applicable,
  tr.not-tested {
    background: #ffffff !important;
  }
}
</file>

